+++ b/src/carriers/postnl.ts
@@ -0,0 +1,10 @@
+import type { Carrier } from "../carrier";
+import { startedKg } from "../shipment";
+
+const COUNTRIES = ["NL", "BE", "DE", "FR"];
+
+export const postnl: Carrier = {
+  id: "postnl",
+  supports: (shipment) => COUNTRIES.includes(shipment.destination) && shipment.weightGrams <= 10_000 && !shipment.express,
+  price: (shipment) => 695 + 100 * Math.max(0, startedKg(shipment) - 2),
+};
