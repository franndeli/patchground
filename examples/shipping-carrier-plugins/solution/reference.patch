+import type { Shipment } from "./shipment";
+
+/** One shipping carrier: whether it takes a parcel and what it charges, in cents. */
+export interface Carrier {
+  readonly id: string;
+  supports(shipment: Shipment): boolean;
+  price(shipment: Shipment): number;
+}
diff --git a/src/carriers/dhl.ts b/src/carriers/dhl.ts
new file mode 100644
index 0000000..014143f
--- /dev/null
+++ b/src/carriers/dhl.ts
@@ -0,0 +1,11 @@
+import type { Carrier } from "../carrier";
+import { startedKg } from "../shipment";
+
+export const dhl: Carrier = {
+  id: "dhl",
+  supports: (shipment) => shipment.weightGrams <= 30_000,
+  price: (shipment) => {
+    const base = 1200 + 150 * startedKg(shipment);
+    return shipment.express ? Math.round(base * 1.5) : base;
+  },
+};
