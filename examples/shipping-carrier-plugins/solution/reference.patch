--- /dev/null
+++ b/src/quoter.ts
@@ -0,0 +1,34 @@
+import type { Carrier } from "./carrier";
+import { UnknownCarrierError, UnsupportedShipmentError } from "./errors";
+import { assertShipment, type Shipment } from "./shipment";
+
+export interface Quoter {
+  quote(shipment: Shipment, carrierId: string): number;
+  availableCarriers(shipment: Shipment): string[];
+}
+
+export function createQuoter(carriers: readonly Carrier[]): Quoter {
+  const byId = new Map<string, Carrier>();
+  for (const carrier of carriers) {
+    if (byId.has(carrier.id)) throw new Error(`duplicate carrier id: ${carrier.id}`);
+    byId.set(carrier.id, carrier);
+  }
+
+  return {
+    quote(shipment, carrierId) {
+      assertShipment(shipment);
+      const carrier = byId.get(carrierId);
+      if (!carrier) throw new UnknownCarrierError(carrierId);
+      if (!carrier.supports(shipment)) throw new UnsupportedShipmentError(carrierId);
+      return carrier.price(shipment);
+    },
+    availableCarriers(shipment) {
+      assertShipment(shipment);
+      return [...byId.values()]
+        .filter((carrier) => carrier.supports(shipment))
+        .map((carrier) => ({ id: carrier.id, cents: carrier.price(shipment) }))
+        .sort((a, b) => a.cents - b.cents || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0))
+        .map(({ id }) => id);
+    },
+  };
+}
