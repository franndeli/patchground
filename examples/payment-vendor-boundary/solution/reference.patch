diff --git a/src/billing/payments.py b/src/billing/payments.py
new file mode 100644
index 0000000..6881301
--- /dev/null
+++ b/src/billing/payments.py
@@ -0,0 +1,38 @@
+"""What billing needs from a payment provider, in billing's own terms."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+from enum import StrEnum
+from typing import Protocol, runtime_checkable
+
+
+class Outcome(StrEnum):
+    APPROVED = "approved"
+    DECLINED = "declined"
+    RETRY = "retry"
+
+
+class Reason(StrEnum):
+    CARD_DECLINED = "card declined"
+    INSUFFICIENT_FUNDS = "insufficient funds"
+    ISSUER_UNAVAILABLE = "issuer unavailable"
+    GATEWAY_TIMEOUT = "gateway timeout"
+
+
+@dataclass(frozen=True)
+class PaymentResult:
+    outcome: Outcome
+    reason: Reason | None
+    reference: str | None
+    paid_at: datetime | None
+
+
+class PaymentGatewayError(RuntimeError):
+    """The provider answered with something billing cannot interpret."""
+
+
+@runtime_checkable
+class PaymentGateway(Protocol):
+    def charge(self, invoice_id: str, amount_cents: int, currency: str) -> PaymentResult: ...
diff --git a/src/billing/paysafe_gateway.py b/src/billing/paysafe_gateway.py
new file mode 100644
index 0000000..6940442
--- /dev/null
+++ b/src/billing/paysafe_gateway.py
@@ -0,0 +1,34 @@
+"""Anti-corruption layer: translate the Paysafe SDK into billing's payment port."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+
+from billing.payments import Outcome, PaymentGatewayError, PaymentResult, Reason
+from paysafe import PaysafeClient, PsTimeout
+
+UNPAID = {
+    "05": (Outcome.DECLINED, Reason.CARD_DECLINED),
+    "51": (Outcome.DECLINED, Reason.INSUFFICIENT_FUNDS),
+    "91": (Outcome.RETRY, Reason.ISSUER_UNAVAILABLE),
+}
+
+
+class PaysafeGateway:
+    def __init__(self, client: PaysafeClient) -> None:
+        self._client = client
+
+    def charge(self, invoice_id: str, amount_cents: int, currency: str) -> PaymentResult:
+        try:
+            response = self._client.charge(invoice_id, amount_cents, currency)
+        except PsTimeout:
+            return PaymentResult(Outcome.RETRY, Reason.GATEWAY_TIMEOUT, None, None)
+        if (response.amt_minor, response.ccy) != (amount_cents, currency):
+            raise PaymentGatewayError(f"paysafe charged {response.amt_minor} {response.ccy} for {invoice_id}")
+        if response.rc == "00":
+            paid_at = datetime.fromtimestamp(response.ts_ms / 1000, UTC)
+            return PaymentResult(Outcome.APPROVED, None, response.txn_ref, paid_at)
+        if response.rc in UNPAID:
+            outcome, reason = UNPAID[response.rc]
+            return PaymentResult(outcome, reason, None, None)
+        raise PaymentGatewayError(f"unexpected paysafe response code {response.rc!r}")
