diff --git a/src/reports/storage.py b/src/reports/storage.py
new file mode 100644
index 0000000..0a50dfc
--- /dev/null
+++ b/src/reports/storage.py
@@ -0,0 +1,23 @@
+"""Read sales from the shop's SQLite database."""
+
+from __future__ import annotations
+
+import sqlite3
+
+from reports.domain import Sale
+
+
+class SqliteSales:
+    def __init__(self, db_path: str) -> None:
+        self._db_path = db_path
+
+    def for_month(self, month: str) -> list[Sale]:
+        connection = sqlite3.connect(self._db_path)
+        try:
+            rows = connection.execute(
+                "SELECT sku, quantity, unit_cents FROM sales WHERE substr(sold_on, 1, 7) = ? ORDER BY id",
+                (month,),
+            ).fetchall()
+        finally:
+            connection.close()
+        return [Sale(sku, quantity, unit_cents) for sku, quantity, unit_cents in rows]
diff --git a/src/reports/text.py b/src/reports/text.py
new file mode 100644
index 0000000..6499fd5
--- /dev/null
+++ b/src/reports/text.py
@@ -0,0 +1,23 @@
+"""Plain-text presentation of a monthly summary."""
+
+from __future__ import annotations
+
+from reports.domain import MonthlySummary
+
+
+def money(cents: int) -> str:
+    sign = "-" if cents < 0 else ""
+    cents = abs(cents)
+    return f"{sign}{cents // 100}.{cents % 100:02d}"
+
+
+def render(summary: MonthlySummary) -> str:
+    lines = [f"Sales report {summary.month}"]
+    if not summary.lines:
+        lines.append("No sales.")
+        return "\n".join(lines) + "\n"
+    for line in summary.lines:
+        lines.append(f"{line.sku:<12}{money(line.net_cents):>10}")
+    lines.append(f"{'Refunds':<12}{money(summary.refunds_cents):>10}")
+    lines.append(f"{'Total':<12}{money(summary.total_cents):>10}")
+    return "\n".join(lines) + "\n"
