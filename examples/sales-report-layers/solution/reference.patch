+"""The report's rules: which sales count, how they net out and in what order. No I/O."""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Iterable
+from dataclasses import dataclass
+
+MONTH = re.compile(r"\d{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Sale:
+    sku: str
+    quantity: int
+    unit_cents: int
+
+
+@dataclass(frozen=True)
+class ProductLine:
+    sku: str
+    net_cents: int
+
+
+@dataclass(frozen=True)
+class MonthlySummary:
+    month: str
+    lines: tuple[ProductLine, ...]
+    refunds_cents: int
+    total_cents: int
+
+
+def check_month(month: str) -> str:
+    if not MONTH.fullmatch(month):
+        raise ValueError(f"month must look like 2026-03, got {month!r}")
+    return month
+
+
+def summarize(month: str, sales: Iterable[Sale]) -> MonthlySummary:
+    check_month(month)
+    net_by_sku: dict[str, int] = {}
+    refunds = 0
+    for sale in sales:
+        amount = sale.quantity * sale.unit_cents
+        if sale.quantity < 0:
+            refunds += -amount
+        net_by_sku[sale.sku] = net_by_sku.get(sale.sku, 0) + amount
+    lines = tuple(
+        ProductLine(sku, net) for sku, net in sorted(net_by_sku.items(), key=lambda item: (-item[1], item[0]))
+    )
+    return MonthlySummary(month, lines, refunds, sum(line.net_cents for line in lines))
