{
  "name": "patchground-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4173",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "check": "node --check src/scripts/enhance.js && node --check src/lib/catalog.mjs && node --check scripts/site.test.mjs && node --check scripts/browser-smoke.mjs",
    "test": "astro build && node --test scripts/*.test.mjs",
    "test:browser": "astro build && node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.5",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3"
  }
}
